# Copy to /etc/discode/discode-bot.env and fill in real values.
# Keep this file readable only by the service user/root.

DISCODE_DISCORD_TOKEN=replace-with-discord-bot-token
DISCODE_DISCORD_CLIENT_ID=replace-with-discord-application-client-id
DISCODE_WS_PORT=8080
DISCODE_STORAGE_PATH=/var/lib/discode/discord-bot
DISCODE_CONFIG_PATH=/etc/discode/discord-bot.config.json
