# Copy to /etc/discode/discode-runner.env and fill in real values.
# Keep this file readable only by the service user/root.

DISCODE_TOKEN=replace-with-token-generated-by-discode-bot
DISCODE_BOT_URL=ws://replace-with-bot-host:8080
DISCODE_RUNNER_NAME=openclaw-codex-runner
DISCODE_CLI_TYPES=codex
DISCODE_DEFAULT_WORKSPACE=/path/to/openclaw/workspace
DISCODE_CLI_SEARCH_PATHS=/path/to/codex/bin,/usr/local/bin,/usr/bin
DISCODE_HTTP_PORT=3122
DISCODE_CONFIG_PATH=/etc/discode/runner.config.json
