[Unit]
Description=DisCode Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/discode/discord-bot
EnvironmentFile=/etc/discode/discode-bot.env
ExecStart=/usr/bin/env bun run src/index.ts
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
